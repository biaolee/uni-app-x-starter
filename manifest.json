{
  "name": "uni-app-x-starter",
  "appid": "",
  "description": "企业级 uni-app x 蒸汽模式多端脚手架",
  "versionName": "1.0.0",
  "versionCode": "100",
  "vueVersion": "3",
  "uni-app-x": {
    "vapor": true,
    "styleIsolationVersion": "2"
  },
  "uniStatistics": {
    "enable": false
  },
  "app": {
    "defaultAppTheme": "auto",
    "distribute": {}
  },
  "app-android": {
    "distribute": {
      "splashScreens": {
        "default": {}
      }
    }
  },
  "app-ios": {
    "distribute": {}
  },
  "app-harmony": {
    "distribute": {}
  },
  "web": {
    "router": {
      "mode": "hash",
      "base": "./"
    },
    "darkmode": true
  },
  "mp-weixin": {
    "appid": "",
    "darkmode": true,
    "usingComponents": true,
    "mergeVirtualHostAttributes": true,
    "optimization": {
      "subPackages": true
    },
    "lazyCodeLoading": "requiredComponents",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "postcss": true,
      "minified": true
    }
  }
}
