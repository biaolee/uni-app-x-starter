# ====================== 所有环境共享配置 ======================
# 应用名称
VITE_APP_TITLE=uni-app-x-starter
# 应用独立存储命名空间；环境与记录版本由适配器自动追加
VITE_STORAGE_NAMESPACE=uni-app-x-starter
# H5 开发服务器端口
VITE_DEV_PORT=9000
VITE_DEV_HOST=127.0.0.1
# H5 是否走 vite 代理（true 时接口前缀 /api 转发到 VITE_PROXY_TARGET）
VITE_H5_USE_PROXY=false
VITE_PROXY_TARGET=http://localhost:3000
VITE_AUTH_MODE=real
# Excel 导入始终直传业务 API；普通文件上传由模式选择后端 OSS 或七牛直传
VITE_FILE_UPLOAD_MODE=server-oss
VITE_EXCEL_IMPORT_PATH=/imports/excel
VITE_SERVER_UPLOAD_PATH=/files/upload
VITE_QINIU_TOKEN_PATH=/files/qiniu-token
# 使用七牛模式时按存储区域配置 HTTPS 上传地址；不要在前端放 AK/SK
VITE_QINIU_UPLOAD_URL=
